{
  "name": "PartCAD Development Environment",
  "image": "ghcr.io/partcad/partcad-devcontainer:0.8.71",
  "remoteEnv": {
    // TODO: @alexanderilyin do not patch PATH here but make `mamba` discoverable.
    "PATH": "${containerEnv:PATH}:/home/vscode/miniforge3/bin",
    // TODO: Enable prepare-commit-msg once rebase problem is fixed.
    // TODO: poetry-* hooks are source of unnecessary conflicts in PRs and should be handled by dependabot.
    "SKIP": "behave,prepare-commit-msg,poetry-install,poetry-lock,poetry-export"
  },
  // Runs on the host, before the container exists: resolves the Docker socket
  // of a host that does not keep one at the standard path, and the running SSH
  // agent. See the second and third "-v" under runArgs below. Named ".cmd"
  // rather than ".sh" because this runs in the host's own shell and a failure
  // here aborts `devcontainer up`: the file is a polyglot that cmd.exe reads as
  // a batch script doing nothing and /bin/sh reads as a wrapper around
  // host-sockets-init.sh. Quoted, so a workspace path with a space in it still
  // resolves.
  "initializeCommand": {
    "host-sockets": "\"${localWorkspaceFolder}/.devcontainer/host-sockets-init.cmd\""
  },
  "postCreateCommand": {
    "Start D-Bus": "sudo service dbus start && (until systemctl is-active --quiet dbus; do sleep 1; done)"
  },
  "postStartCommand": {
    "pre-commit": "pre-commit install --config dev-tools/pre-commit-config.yaml",
    "docker-socket": ".devcontainer/docker-socket-start.sh"
  },
  "runArgs": [
    "--privileged",
    // The host's Docker daemon, so that this container can start containers of
    // its own -- PartCAD's KiCad sandbox, for one. Two candidates, which
    // .devcontainer/docker-socket-start.sh tries in this order.
    //
    // The standard path first: on macOS and Windows the daemon is not there at
    // all (on Windows it is a named pipe), and this exact name is what Docker
    // Desktop translates, so no other spelling works on those hosts.
    "-v", "/var/run/docker.sock:/var/run/docker-host.sock",
    // Then whatever .devcontainer/host-sockets-init.sh resolved, for a Linux
    // host that keeps its daemon somewhere else: rootless, a unix:// value in
    // DOCKER_HOST, Colima.
    "-v", "/tmp/partcad-devcontainer-${localEnv:USER}/docker.sock:/var/run/docker-host-alt.sock",
    // The host's SSH agent, resolved by the same script from SSH_AUTH_SOCK, so
    // that a clone over SSH from in here authenticates with the host's keys
    // and the private half stays on the host. The VS Code Dev Containers
    // extension forwards the agent by itself and sets SSH_AUTH_SOCK to its own
    // socket, which is why nothing points at this one by default -- overriding
    // that would take agent forwarding away from the editor to give it back.
    // What has no agent otherwise is `devcontainer up`, which forwards none:
    // a terminal (AGENTS.md says to export SSH_AUTH_SOCK=/run/host-ssh-agent.sock
    // there) and CI (test-dev.yml passes it to the behave job, whose scenarios
    // clone over SSH).
    //
    // POSIX hosts only, WSL2 included. A native Windows host keeps its agent
    // behind the named pipe \\.\pipe\openssh-ssh-agent, which is not something
    // a Linux container can be handed as a unix socket, so this stays the empty
    // directory and nothing here bridges it -- see host-sockets-init.cmd. That
    // costs Windows nothing it had: the editor forwards its own agent there as
    // everywhere, and CI runs this job on ubuntu.
    "-v", "/tmp/partcad-devcontainer-${localEnv:USER}/ssh-agent.sock:/run/host-ssh-agent.sock"
    // All three are "-v" rather than "mounts" entries deliberately: "mounts"
    // turns into "--mount", which aborts `devcontainer up` when the source does
    // not exist, whereas "-v" leaves an empty directory in its place, which the
    // container side reads as "nothing here" and passes over in silence.
  ],
  "mounts": [
    // TODO: For some reason this leads to tests hanging in the CI.
    // "source=partcad-partcad,target=/home/vscode/.partcad,type=volume",
    "source=partcad-cache,target=/home/vscode/.cache,type=volume",
    "source=partcad-config,target=/home/vscode/.config,type=volume"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "2.96.0"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {
      "jqVersion": "1.8.2",
      "yqVersion": "4.53.3",
      "gojqVersion": "none",
      "xqVersion": "none",
      "jaqVersion": "none"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": true,
      "installDirectlyFromGitHubRelease": true,
      "version": "3.7.1"
    },
    // "ghcr.io/devcontainers/features/node:1": {
    //   "version": "1.6.1",
    //   "nodeGypDependencies": true
    // },
    "ghcr.io/devcontainers-community/npm-features/typescript:1": {
      "version": "6.0.3"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotfiles.repository": "partcad/devcontainer-dotfiles"
      },
      "remote.extensionKind": {
        "codecov.codecov": [
          "ui"
        ]
      },
      // <!-- prettier-ignore-start -->
      "extensions": [
        "PartCAD.partcad-official",
        // Git Tools
        "eamodio.gitlens",
        // Python Environment
        "donjayamanne.python-environment-manager",
        "njpwerner.autodocstring", // Python docstring generator
        "kevinrose.vsc-python-indent", // Better Python indentation
        "ms-python.black-formatter",
        "ms-python.python",
        "ms-python.vscode-pylance",
        // Code Formatting
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker", // Because typos are worse than black holes
        // GitHub Integration
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        // File Headers
        "psioniq.psi-header",
        // Docker Support
        "ms-azuretools.vscode-docker",
        // YAML Support
        "redhat.vscode-yaml", // TODO-20:command 'jumpToSchema' already exists
        // SVG Support
        "jock.svg",
        // Jinja Support
        "samuelcolvin.jinjahtml",
        // Markdown Support
        "yzhang.markdown-all-in-one",
        "bierner.github-markdown-preview",
        "bierner.markdown-checkbox",
        "bierner.markdown-footnotes",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-yaml-preamble",
        "chintans98.markdown-jira",
        // Task Management
        "Gruntfuggly.todo-tree",
        "wayou.vscode-todo-highlight", // Additional TODO highlighting
        // Atlassian Integration
        "Atlassian.atlascode",
        // Documentation Support
        "swyddfa.esbonio",
        "lextudio.restructuredtext",
        "trond-snekvik.simple-rst",
        // Code Analysis
        "alexkrechik.cucumberautocomplete",
        "bbenoist.vagrant",
        "codecov.codecov",
        "hediet.debug-visualizer",
        "ryanluker.vscode-coverage-gutters"
      ]
      // <!-- prettier-ignore-end -->
    }
  }
}
