                { "type": "null" }
              ]
            },
            "exclude": { "type": "string", "minLength": 1 },
            "use-wires": { "type": "boolean", "default": false },
            "use-faces": { "type": "boolean", "default": false },
            "ignore-visibility": { "type": "boolean", "default": false },
            "flip-y": { "type": "boolean", "default": false },
            "source": { "type": "string", "minLength": 1 },
            "package": { "type": "string", "minLength": 1 },
            "circle": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                {
                  "type": "object",
                  "properties": {
                    "radius": { "type": "number", "minimum": 0 },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "required": ["radius"],
                  "additionalProperties": false
                }
              ]
            },
            "square": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                {
                  "type": "object",
                  "properties": {
                    "side": { "type": "number", "minimum": 0 },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "required": ["side", "x", "y"],
                  "additionalProperties": false
                }
              ]
            },
            "rectangle": {
              "type": "object",
              "properties": {
                "side-x": { "type": "number", "minimum": 0 },
                "side-y": { "type": "number", "minimum": 0 },
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "required": ["side-x", "side-y"],
              "additionalProperties": false
            },
            "inner": {
              "type": "object",
              "properties": {
                "circle": {
                  "oneOf": [
                    { "type": "number", "minimum": 0 },
                    {
                      "type": "object",
                      "properties": {
                        "radius": { "type": "number", "minimum": 0 }
                      },
                      "required": ["radius"],
                      "additionalProperties": false
                    }
                  ]
                },
                "square": {
                  "oneOf": [
                    { "type": "number", "minimum": 0 },
                    {
                      "type": "object",
                      "properties": {
                        "side": { "type": "number", "minimum": 0 },
                        "x": { "type": "number" },
                        "y": { "type": "number" }
                      },
                      "required": ["side"],
                      "additionalProperties": false
                    }
                  ]
                },
                "rectangle": {
                  "type": "object",
                  "properties": {
                    "side-x": { "type": "number", "minimum": 0 },
                    "side-y": { "type": "number", "minimum": 0 },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "required": ["side-x", "side-y"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "with": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_/./-]+$": { "type": ["string", "number", "boolean"] }
              },
              "additionalProperties": false
            }
          },
          "required": ["type"],
          "dependencies": { "fileFrom": ["fileUrl"], "fileUrl": ["fileFrom"] },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interfaces": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_/./-]+$": {
          "type": "object",
          "properties": {
            "abstract": { "type": "boolean", "default": false },
            "desc": { "type": "string", "maxLength": 1000 },
            "unless": { "$ref": "#/definitions/unless" },
            "path": { "type": "string", "minLength": 1 },
            "leadPort": { "type": "string", "minLength": 1 },
            "threadStep": {
              "description": "The axial distance a connection made through this interface advances per full turn, in mm. Inherited by the interfaces that inherit this one, and by the connections that use it.",
              "type": "number",
              "minimum": 0
            },
            "selfScrew": {
              "description": "Whether this interface cuts its own thread rather than matching one, so that it may be connected to an interface with a different 'threadStep' or none.",
              "type": "boolean",
              "default": false
            },
            "inherits":{
              "type": "object",
              "patternProperties":{
                "^[a-zA-Z0-9_/./-]+$":{
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 1 },
                    { "$ref": "#/definitions/OCCTLocation" },
                    {
                      "type": "object",
                      "patternProperties": {
                        "^[a-zA-Z0-9_/./-]+$": { "$ref": "#/definitions/OCCTLocation" }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "ports":{
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_/./-]+$": { "$ref": "#/definitions/port" }
              },
              "additionalProperties": false
            },
            "mates": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z0-9_/./-]+$": { "$ref": "#/definitions/interface-parameter"}
                  },
                  "additionalProperties": false
                }
              ]
            },
            "parameters": { "$ref": "#/definitions/interface-parameter"},
            "motion": { "$ref": "#/definitions/motion" },
            "physics": { "$ref": "#/definitions/physics" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_/./-]+$": {
          "type": "object",
          "properties": {
