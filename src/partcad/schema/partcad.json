    "repositories": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_/./-]+$": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["basic", "enrich"] },
            "desc": { "type": "string", "maxLength": 1000 },
            "source": { "type": "string", "minLength": 1 },
            "package": { "type": "string", "minLength": 1 },
