[run]
branch = True
concurrency = thread
# Name every package explicitly. The old value relied on the CI checkout
# path (.../work/partcad/partcad/...) making */partcad/* match everything,
# which silently excluded partcad-utils and partcad-service-json-rpc from
# any run outside CI.
include =
        */partcad/*
        */partcad-cli/*
        */partcad-utils/*
        */partcad-service-json-rpc/*
        */partcad-cad-freecad/*
disable_warnings = already-imported
parallel = True
omit =
        */.partcad/*
        */sandbox/*

[report]
ignore_errors = True
