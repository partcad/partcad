description: |
  Two screws driven into a plate, described by the file itself.

  The package that declares this assembly says it better, so this text only
  reaches the documents of the declaration that carries no "desc" of its own.
links:
  - part: plate
    description: |
      The plate the screws are driven into. It is the fixture here: lay it flat
      before starting.

  - part: screw
    name: screw-tl
    description: The screw in the top left hole.
    connect:
      name: plate
      to: m3-thru
      toInstance: TL
      comment: |
        Start this screw by hand: the plate flexes if it is torqued down first.
      how:
        stage: snug
        pushForceMax: 2.5
        pushDistance: 12.0
        turnDirection: ccw
        turnTorqueMax: 1.2
        threadStep: 0.35
        holdWith: grip
        holdWithForce: 6.0
        holdTo: grip
        holdToInstance: left
        holdToForceMax: 8.0

  - part: screw
    name: screw-tr
    connect:
      name: plate
      to: m3-thru
      toInstance: TR
      how:
        stage: snug
