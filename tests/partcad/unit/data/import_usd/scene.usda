#usda 1.0
(
    doc = "A Y-up stage in centimetres: a triangle placed by a turned and scaled parent, and three instances of another."
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Arm"
    {
        float3 xformOp:rotateXYZ = (0, 90, 0)
        float3 xformOp:scale = (2, 2, 2)
        double3 xformOp:translate = (10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Mesh "Triangle"
        {
            float3 xformOp:scale = (1, 3, 1)
            double3 xformOp:translate = (0, 0, 5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }

    def Xform "Copy1" (
        instanceable = true
        prepend references = </Prototypes/Thing>
    )
    {
        double3 xformOp:translate = (0, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Copy2" (
        instanceable = true
        prepend references = </Prototypes/Thing>
    )
    {
        double3 xformOp:translate = (0, 40, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Copy3" (
        instanceable = true
        prepend references = </Prototypes/Thing>
    )
    {
        double3 xformOp:translate = (0, 60, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

class Xform "Prototypes"
{
    def Xform "Thing"
    {
        def Mesh "Triangle"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            color3f[] primvars:displayColor = [(0, 1, 0)]
        }
    }
}
