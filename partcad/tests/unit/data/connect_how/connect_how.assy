links:
  - part: plate

  - part: screw
    name: screw-tl
    connect:
      name: plate
      to: m3-thru
      toInstance: TL
      comment: |
        Start this screw by hand: the plate flexes if it is torqued down first.
      how:
        pushForceMax: 2.5
        turnDirection: ccw
        turnTorqueMax: 1.2
        threadStep: 0.5
        holdWith: grip
        holdTo: grip
        holdToInstance: left

  - part: screw
    name: screw-tr
    connect:
      name: plate
      to: m3-thru
      toInstance: TR
      how:
        threadStep: 0.5
