links:
  - part: plate

  - part: screw
    name: screw-tl
    connect:
      name: plate
      to: m3-thru
      toInstance: TL
      comment: |
        Start this screw by hand: the plate flexes if it is torqued down first.
      how:
        stage: snug
        pushForceMax: 2.5
        pushDistance: 12.0
        turnDirection: ccw
        turnTorqueMax: 1.2
        threadStep: 0.5
        holdWith: grip
        holdWithForce: 6.0
        holdTo: grip
        holdToInstance: left
        holdToForceMax: 8.0

  - part: screw
    name: screw-tr
    connect:
      name: plate
      to: m3-thru
      toInstance: TR
      how:
        stage: snug
        threadStep: 0.5
