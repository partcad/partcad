{
  "name": "partcad",
  "displayName": "PartCAD",
  "description": "Build system and package manager for CAD files, and assembly modeling framework",
  "markdown": "github",
  "icon": "resources/logo_128x128.png",
  "version": "0.7.169",
  "serverInfo": {
    "name": "PartCAD",
    "module": "partcad"
  },
  "publisher": "OpenVMP",
  "license": "Apache-2.0",
  "homepage": "https://partcad.readthedocs.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openvmp/partcad.git"
  },
  "bugs": {
    "url": "https://github.com/openvmp/partcad/issues"
  },
  "galleryBanner": {
    "color": "#1e415e",
    "theme": "dark"
  },
  "keywords": [
    "partcad",
    "cad",
    "cadquery",
    "build123d",
    "openscad",
    "ollama",
    "openai",
    "gemini",
    "step",
    "stl",
    "dxf",
    "threejs",
    "autodesk",
    "solidworks",
    "gltf",
    "iges"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "extensionDependencies": [
    "ms-python.python",
    "bernhard-42.ocp-cad-viewer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PartCAD does not support untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Virtual Workspaces are not supported with PartCAD."
    }
  },
  "activationEvents": [
    "workspaceContains:partcad.yaml",
    "onView:ocpCadStatus",
    "onWebviewPanel:OcpCadViewer",
    "workspaceContains:*.assy",
    "workspaceContains:*cadquery*",
    "workspaceContains:*build123d*",
    "workspaceContains:*.scad",
    "workspaceContains:*.step",
    "workspaceContains:*.stl",
    "workspaceContains:*.3mf",
    "workspaceContains:*.dxf",
    "workspaceContains:*.svg"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool source-map --config ./webpack.config.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "format-check": "prettier --check 'src/**/*.ts' 'build/**/*.yml' '.github/**/*.yml'",
    "test": "vscode-test",
    "vsce-package": "vsce package -o partcad.vsix"
  },
  "contributes": {
    "languages": [
      {
        "filenames": [
          "partcad.yaml"
        ],
        "id": "yaml",
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      },
      {
        "id": "yaml",
        "extensions": [
          ".assy"
        ],
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      }
    ],
    "configuration": [
      {
        "title": "Backend",
        "order": 0,
        "properties": {
          "partcad.backend": {
            "default": "service",
            "description": "How the extension talks to PartCAD. 'service' runs the standalone 'partcad-json-rpc' executable (downloaded on demand, no Python required). 'python' uses a Python interpreter and the bundled language server, as in previous versions.",
            "enum": [
              "service",
              "python"
            ],
            "enumDescriptions": [
              "Use the standalone partcad-json-rpc service (recommended; no Python environment required).",
              "Use a Python interpreter and the bundled language server."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.servicePath": {
            "default": "",
            "description": "Path to a 'partcad-json-rpc' executable. When empty, the extension looks for an existing standalone installation, then offers to download one. Only used when 'partcad.backend' is 'service'.",
            "scope": "machine",
            "type": "string"
          },
          "partcad.serviceChannel": {
            "default": "socket",
            "description": "How the extension connects to the PartCAD service. 'socket' uses a shared per-workspace background daemon (recommended); 'stdio' runs a dedicated service process over stdin/stdout. Only used when 'partcad.backend' is 'service'.",
            "enum": [
              "socket",
              "stdio"
            ],
            "enumDescriptions": [
              "Connect to the shared per-workspace daemon over a socket (or a named pipe on Windows).",
              "Run a dedicated service process and talk to it over stdin/stdout."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.serviceDownloadRepository": {
            "default": "partcad/partcad",
            "description": "GitHub repository (owner/name) to download the standalone PartCAD bundle from. Only used when 'partcad.backend' is 'service'.",
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Python",
        "order": 1,
        "properties": {
          "partcad.pythonSandbox": {
            "default": "conda",
            "description": "What sandboxing method to use for invoking Python scripts?",
            "enum": [
              "conda",
              "pypy",
              "none"
            ],
            "enumDescriptions": [
              "Use conda to create a sandboxed environment.",
              "Use pypy to create a sandboxed environment.",
              "Do not create a sandboxed environment. Use the current Python environment instead."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "General",
        "order": 3,
        "properties": {
          "partcad.lint.enabled": {
            "default": true,
            "description": "Check ASSY files for Jinja2, YAML and schema errors while editing, and report them in the Problems view.",
            "scope": "resource",
            "type": "boolean"
          },
          "partcad.verbosity": {
            "default": "info",
            "description": "What level of logs need to be displayed in the PartCAD terminal view?",
            "enum": [
              "debug",
              "info",
              "error"
            ],
            "enumDescriptions": [
              "Show debug information (especially useful for debugging AI).",
              "Show regular informational messages.",
              "Show errors only."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.packagePath": {
            "default": ".",
            "description": "Relative path to the PartCad package root from the workspace root.",
            "scope": "resource",
            "type": "string"
          },
          "partcad.forceUpdate": {
            "default": "false",
            "description": "Whether to update all dependencies on each run, instead of once a day.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Update all dependencies on each run.",
              "Update dependencies once a day."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.develIndex": {
            "default": false,
            "description": "Whether to take the public PartCAD index from its 'devel' branch instead of the released state on 'main'. Turn this on to work against index changes that have not been released yet.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.importStrategy": {
            "default": "useBundled",
            "description": "Defines where `partcad` is imported from. This setting may be ignored if `partcad.path` is set.",
            "enum": [
              "useBundled",
              "fromEnvironment"
            ],
            "enumDescriptions": [
              "Always use the bundled version of `partcad`.",
              "Use `partcad` from environment, fallback to bundled version only if `partcad` not available in the environment."
            ],
            "scope": "window",
            "type": "string"
          },
          "partcad.interpreter": {
            "default": [],
            "description": "When set to a path to python executable, extension will use that to launch the server and any subprocess.",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "partcad.showNotifications": {
            "default": "always",
            "description": "Controls when notifications are shown by this extension.",
            "enum": [
              "off",
              "onError",
              "onWarning",
              "always"
            ],
            "enumDescriptions": [
              "All notifications are turned off, any errors or warning are still available in the logs.",
              "Notifications are shown only in the case of an error.",
              "Notifications are shown for errors and warnings.",
              "Notifications are show for anything that the server chooses to show."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.telemetry": {
            "default": "on",
            "description": "Controls whether to send PartCAD processes telemetry data to help with PartCAD development. PartCAD collects error messages and time measurements of internal components to guide performance optimization.",
            "enum": [
              "on",
              "off"
            ],
            "enumDescriptions": [
              "PartCAD Telemetry is enabled.",
              "PartCAD Telemetry is disabled."
            ],
            "scope": "machine",
            "tags": [
              "telemetry",
              "usesOnlineServices"
            ],
            "type": "string"
          },
          "partcad.reopenTerminal": {
            "default": "true",
            "description": "Whether to re-open PartCAD terminal tab on new PartCAD events or not.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Re-open PartCAD terminal on new events, if it was closed.",
              "Do not re-open PartCAD terminal if closed once."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.popupTerminal": {
            "default": "false",
            "description": "Whether to bring the PartCAD terminal tab up on new PartCAD events or not.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Bring the PartCAD terminal up on new events, if it was hidden.",
              "Do not bring the PartCAD terminal up on new events if it is hidden."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      }
    ],
    "commands": [
      {
        "title": "Restart PartCAD",
        "category": "PartCAD",
        "command": "partcad.restart",
        "icon": "$(refresh)"
      },
      {
        "title": "Update PartCAD",
        "category": "PartCAD",
        "command": "partcad.update",
        "icon": "$(cloud-download)"
      },
      {
        "command": "partcad.promptInitPackage",
        "category": "PartCAD",
        "title": "Initialize new package",
        "icon": "$(new-folder)"
      },
      {
        "command": "partcad.promptInitPackageCustom",
        "category": "PartCAD",
        "title": "Initialize new package at a custom path",
        "icon": "$(new-folder)"
      },
      {
        "command": "partcad.promptLoadPackage",
        "category": "PartCAD",
        "title": "Open package",
        "icon": "$(folder-opened)"
      },
      {
        "title": "Reload the package",
        "category": "PartCAD",
        "command": "partcad.refresh",
        "icon": "$(sync)"
      },
      {
        "title": "PartCAD support",
        "category": "PartCAD",
        "command": "partcad.support",
        "icon": "$(icon)"
      },
      {
        "command": "partcad.addPart",
        "category": "PartCAD",
        "title": "Add a part",
        "icon": "$(file-add)"
      },
      {
        "command": "partcad.addPartItem",
        "category": "PartCAD",
        "title": "Add a part",
        "icon": "$(file-add)"
      },
      {
        "command": "partcad.addAssembly",
        "category": "PartCAD",
        "title": "Add an assembly",
        "icon": "$(diff-added)"
      },
      {
        "command": "partcad.addAssemblyItem",
        "category": "PartCAD",
        "title": "Add an assembly",
        "icon": "$(diff-added)"
      },
      {
        "command": "partcad.addSketch",
        "category": "PartCAD",
        "title": "Add a sketch",
        "icon": "$(error)"
      },
      {
        "command": "partcad.addInterface",
        "category": "PartCAD",
        "title": "Add an interface",
        "icon": "$(error)"
      },
      {
        "command": "partcad.importSketch",
        "category": "PartCAD",
        "title": "Import a sketch",
        "icon": "$(error)"
      },
      {
        "command": "partcad.importPart",
        "category": "PartCAD",
        "title": "Import a part",
        "icon": "$(error)"
      },
      {
        "command": "partcad.importAssembly",
        "category": "PartCAD",
        "title": "Import an assembly",
        "icon": "$(error)"
      },
      {
        "command": "partcad.inspectSketch",
        "category": "PartCAD",
        "title": "Display",
        "icon": "$(eye)"
      },
      {
        "command": "partcad.inspectPart",
        "category": "PartCAD",
        "title": "Display",
        "icon": "$(eye)"
      },
      {
        "command": "partcad.inspectPartWithCode",
        "category": "PartCAD",
        "title": "Display and edit",
        "icon": "$(eye)"
      },
      {
        "command": "partcad.inspectAssembly",
        "category": "PartCAD",
        "title": "Display",
        "icon": "$(eye)"
      },
      {
        "command": "partcad.inspectInterface",
        "category": "PartCAD",
        "title": "Display",
        "icon": "$(eye)"
      },
      {
        "command": "partcad.test",
        "category": "PartCAD",
        "title": "Test",
