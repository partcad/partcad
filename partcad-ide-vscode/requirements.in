# This file is used to generate requirements.txt.
# NOTE:
# Use Python 3.8 or greater which ever is the minimum version of the python
# you plan on supporting when creating the environment or using pip-tools.
# Only run the commands below to manully upgrade packages in requirements.txt:
# 1) python -m pip install pip-tools
# 2) pip-compile --generate-hashes --resolver=backtracking --upgrade ./requirements.in
# If you are using nox commands to setup or build package you don't need to
# run the above commands manually.

# Required packages
# pygls is capped below 2 on purpose: pygls 2.x dropped pygls.server.LanguageServer
# (and reworked the command/notification decorators) that bundled/tool/lsp_server.py
# relies on. Without this cap, pip-compile --upgrade floats pygls to 2.x and the
# bundled language server fails to start. Lift the cap only alongside a 2.x port.
pygls>=1.3.1,<2
packaging>=23.1
typing_extensions
python-jsonrpc-server

# partcad — keep this mirror of partcad's runtime dependencies in sync with
# ../partcad/requirements.txt (minus the heavy CAD kernels cadquery-ocp/ocpsvg/
# build123d, which ship with the separately installed partcad package).
pyyaml>=6.0.1
# Pinned for the same reason as in ../partcad/requirements.txt: pygit2 drops
# deprecated API across minor releases, and '--upgrade' here would otherwise
# float the bundle onto one. 1.18.2 is the last line supporting Python 3.10,
# which is what this file is compiled against.
pygit2==1.18.2; python_version < "3.11"
pygit2==1.20.0; python_version >= "3.11"
