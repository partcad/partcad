msgstr "``--platform <id>``"

#: ../../source/installation.rst:257
msgid "``PARTCAD_PLATFORM``"
msgstr "``PARTCAD_PLATFORM``"

#: ../../source/installation.rst:257
msgid "detected from this machine"
msgstr "определяется по этой машине"

#: ../../source/installation.rst:258
msgid "``--ide``"
msgstr "``--ide``"

#: ../../source/installation.rst:258
