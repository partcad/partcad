#~ "единой жалобы: нулевая масса, тензор "
#~ "инерции, не являющийся положительно "
#~ "определённым, тензор, нарушающий неравенство "
#~ "треугольника, и объявленная масса, "
#~ "расходящаяся с произведением объёма на "
#~ "плотность больше, чем на величину "
#~ "допуска."

#~ msgid ""
#~ "Anisotropic friction is the one property"
