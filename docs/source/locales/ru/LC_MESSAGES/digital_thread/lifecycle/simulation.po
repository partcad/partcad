msgstr "остаётся на месте: 0,5 мм сползания, 0,4 мм осадки"

#: ../../source/digital_thread/lifecycle/simulation.rst:1097
msgid "0.4"
msgstr "0.4"

#: ../../source/digital_thread/lifecycle/simulation.rst:1098
