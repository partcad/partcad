msgstr "Ruft die Fähigkeiten dieses Anbieters ab."

#: ../../source/configuration.rst:1128
msgid "`output[\"materials\"]`: the dictionary of supported materials"
msgstr "`output[\"materials\"]`: das Dictionary der unterstützten Materialien"

#: ../../source/configuration.rst:1138
