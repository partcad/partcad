msgstr "`output[\"available\"]`: booleano, si está disponible en esta tienda"

#: ../../source/configuration.rst:1094 ../../source/configuration.rst:1140
msgid "`request[\"api\"] == \"quote\"`"
msgstr "`request[\"api\"] == \"quote\"`"

#: ../../source/configuration.rst:1096 ../../source/configuration.rst:1142
msgid ""
"Get a quote for the specific cart of parts. Quote API is the core of the "
"provider. It is expected to return the price of a cart."
msgstr ""
"Obtiene una cotización para el carrito específico de piezas. La API de "
"cotización es el núcleo del proveedor. Se espera que devuelva el precio "
"de un carrito."

#: ../../source/configuration.rst:1100 ../../source/configuration.rst:1146
msgid "`request[\"cart\"][\"parts\"]`: the dictionary of parts"
msgstr "`request[\"cart\"][\"parts\"]`: el diccionario de piezas"

#: ../../source/configuration.rst:1101
msgid "`request[\"cart\"][\"parts\"][<id>][\"vendor\"]`: the vendor of the part"
msgstr "`request[\"cart\"][\"parts\"][<id>][\"vendor\"]`: el proveedor de la pieza"

#: ../../source/configuration.rst:1102
msgid "`request[\"cart\"][\"parts\"][<id>][\"sku\"]`: the SKU of the part"
msgstr "`request[\"cart\"][\"parts\"][<id>][\"sku\"]`: el SKU de la pieza"

#: ../../source/configuration.rst:1103
msgid ""
"`request[\"cart\"][\"parts\"][<id>][\"count\"]`: the requested quantity "
"of the parts"
msgstr ""
"`request[\"cart\"][\"parts\"][<id>][\"count\"]`: la cantidad solicitada "
"de las piezas"

#: ../../source/configuration.rst:1104
msgid ""
"`request[\"cart\"][\"parts\"][<id>][\"count_per_sku\"]`: the known number"
" of parts per SKU"
msgstr ""
"`request[\"cart\"][\"parts\"][<id>][\"count_per_sku\"]`: el número "
"conocido de piezas por SKU"

#: ../../source/configuration.rst:1105 ../../source/configuration.rst:1149
msgid "`output[\"price\"]`: the total price of the cart"
msgstr "`output[\"price\"]`: el precio total del carrito"

#: ../../source/configuration.rst:1106 ../../source/configuration.rst:1150
msgid "`output[\"cartId\"]`: the id of the cart (to be used for the order later)"
msgstr ""
"`output[\"cartId\"]`: el id del carrito (para usarse en el pedido "
"posteriormente)"

#: ../../source/configuration.rst:1108 ../../source/configuration.rst:1152
msgid "`request[\"api\"] == \"order\"`"
msgstr "`request[\"api\"] == \"order\"`"

#: ../../source/configuration.rst:1110 ../../source/configuration.rst:1154
msgid ""
"Order the specific quote. Order API does not need to be implemented as "
"there is no infrastructure for payments yet."
msgstr ""
"Realiza el pedido de la cotización específica. La API de pedido no "
"necesita implementarse ya que aún no hay infraestructura para pagos."

#: ../../source/configuration.rst:1114 ../../source/configuration.rst:1158
msgid "`request[\"cartId\"]`: the id of the cart to be purchased"
msgstr "`request[\"cartId\"]`: el id del carrito a comprar"

