links:
  - part: bone
    package: ../produce_part_cadquery_logo
    name: bone1
    # What this item is, in words. It is shown with the step that adds it in the
    # assembly instruction book ('pc render -t pdf' and '-t html'), and nothing
    # else in PartCAD reads it.
    description: The first of the two crossed bones, laid flat.
    location: [[0,0,0], [0,0,1], 0]
  - part: bone
    package: ../produce_part_cadquery_logo
    name: bone2
    location: [[0,0,-2.5], [0,0,1], -90]
  - links:
      - part: head_half
        package: ../produce_part_cadquery_logo
        name: head_half_1
        location: [[0,0,2.5], [0,0,1], 0]
      - part: head_half
        package: ../produce_part_cadquery_logo
        name: head_half_2
        location: [[0,0,0], [0,0,1], -90]
    name: {{name}}_head
    # On a container node, "description" is what the sub-assembly it declares
    # is: the instruction book puts it on that sub-assembly's own page.
    description: The skull, made of two identical halves.
    location: [[0,0,25], [1,0,0], 0]
  - part: bolt
    package: ../produce_part_step
    location: [[0,0,7.5], [0,0,1], 0]
