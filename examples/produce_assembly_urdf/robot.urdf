<?xml version="1.0"?>
<!--
  A small URDF used as a PartCAD assembly (see partcad.yaml).

  It is deliberately more than PartCAD's assembly *geometry* can hold: it has
  masses and inertia tensors, materials, a revolute joint with limits and
  dynamics, a continuous one, fixed ones, and a Gazebo block. The physics
  becomes named PartCAD properties and the joints become the assembly's joints -
  see docs/source/simulation.rst for the mapping - and what an assembly cannot
  hold is counted and reported, which is the other half of the point of the
  example.
-->
<robot name="partcad_urdf_example">

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>

  <!-- The root link. It is a part of the assembly like every other link; the
       assembly itself is the container that holds them. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- The collision shape is what a simulator resolves contact against, and
         it is what PartCAD builds the link from unless 'ignoreCollision' says
         otherwise. Here it is deliberately a little larger than the visual one,
         which is kept as the part 'robot/base_link/visual'. -->
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.13 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.78"/>
      <inertia ixx="9.75e-4" ixy="0" ixz="0" iyy="9.75e-4" iyz="0" izz="1.87e-3"/>
    </inertial>
  </link>

  <!-- A movable joint: the shoulder's joint to the base, which the assembly
       shows at its zero position. Its axis, limits and dynamics are the joint's
       ('pc info -a robot' lists it), and become the 'motion:' and 'physics:' of
       the interface it turns into under 'pc convert assembly -t assy'. -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="12.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="shoulder">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.32"/>
      <inertia ixx="1.46e-4" ixy="0" ixz="0" iyy="1.46e-4" iyz="0" izz="1.00e-4"/>
    </inertial>
  </link>

  <!-- A fixed joint keeps nothing free: the forearm is welded to the shoulder,
       and turns with it. Both are one rigid body, so an export writes them as
       one link of two shapes. -->
  <joint name="elbow" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0.7853981634 0"/>
    <parent link="shoulder"/>
    <child link="forearm"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- A joint with no limits, which turns all the way round: the wrist spins
       about the forearm's own length. -->
  <joint name="wrist" type="continuous">
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <parent link="forearm"/>
    <child link="wrist"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02"/>
  </joint>

  <!-- A link whose two shapes are told apart. Its visual geometry is two
       elements, which become the sub-assembly 'robot/wrist' of the parts
       'robot/wrist/1' and 'robot/wrist/2'; its collision geometry is one simple
       mesh, which becomes the single part 'robot/wrist'. Which of the two the
       link is built from is what 'ignoreCollision' decides. -->
  <link name="wrist">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>
    <visual>
      <!-- A mesh from another package in this repository. 'package://' is
           resolved against the packages around the URDF file, and 'scale' is
           what says the mesh file itself is in millimetres. -->
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://produce_part_stl/cube.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://produce_part_stl/cube.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
