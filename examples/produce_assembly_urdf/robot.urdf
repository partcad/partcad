<?xml version="1.0"?>
<!--
  A small URDF used as a PartCAD assembly (see partcad.yaml).

  It is deliberately more than PartCAD's assembly representation can hold: it
  has masses and inertia tensors, materials, a revolute joint with limits and
  dynamics, and a Gazebo block. Reading it reports what had to be dropped, which
  is the point of the example - see the URDF section of docs/source/design.rst.
-->
<robot name="partcad_urdf_example">

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1.0"/>
  </material>

  <!-- The root link. It becomes the PartCAD assembly itself. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.02"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.78"/>
      <inertia ixx="9.75e-4" ixy="0" ixz="0" iyy="9.75e-4" iyz="0" izz="1.87e-3"/>
    </inertial>
  </link>

  <!-- A movable joint. A PartCAD assembly is one static configuration, so the
       shoulder is placed at this joint's zero position and the axis, the limits
       and the dynamics are dropped. -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="12.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="shoulder">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.32"/>
      <inertia ixx="1.46e-4" ixy="0" ixz="0" iyy="1.46e-4" iyz="0" izz="1.00e-4"/>
    </inertial>
  </link>

  <joint name="elbow" type="fixed">
    <origin xyz="0 0 0.06" rpy="0 0.7853981634 0"/>
    <parent link="shoulder"/>
    <child link="forearm"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="wrist" type="fixed">
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <parent link="forearm"/>
    <child link="wrist"/>
  </joint>

  <!-- A link with two visuals. It becomes a sub-assembly holding both. -->
  <link name="wrist">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>
    <visual>
      <!-- A mesh from another package in this repository. 'package://' is
           resolved against the packages around the URDF file, and 'scale' is
           what says the mesh file itself is in millimetres. -->
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://produce_part_stl/cube.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <gazebo reference="base_link">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
