    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "1.82.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "glob": "^13.0.6",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  }
}
