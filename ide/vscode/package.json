{
  "name": "partcad-official",
  "displayName": "PartCAD",
  "description": "Build system and package manager for CAD files, and assembly modeling framework",
  "markdown": "github",
  "icon": "resources/logo_128x128.png",
  "version": "0.8.168",
  "serverInfo": {
    "name": "PartCAD",
    "module": "partcad"
  },
  "publisher": "PartCAD",
  "license": "Apache-2.0",
  "homepage": "https://partcad.readthedocs.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/partcad/partcad.git"
  },
  "bugs": {
    "url": "https://github.com/partcad/partcad/issues"
  },
  "galleryBanner": {
    "color": "#1e415e",
    "theme": "dark"
  },
  "keywords": [
    "partcad",
    "cad",
    "cadquery",
    "build123d",
    "openscad",
    "step",
    "stl",
    "dxf",
    "threejs",
    "autodesk",
    "solidworks",
    "gltf",
    "iges"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Opening a PartCAD package runs the code its parts are written in, so in Restricted Mode the extension starts nothing: the PartCAD Explorer says the folder has to be trusted, and the extension starts once it is."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Virtual Workspaces are not supported with PartCAD."
    }
  },
  "activationEvents": [
    "workspaceContains:partcad.yaml",
    "onWebviewPanel:partcadViewer",
    "workspaceContains:*.assy",
    "workspaceContains:*cadquery*",
    "workspaceContains:*build123d*",
    "workspaceContains:*.scad",
    "workspaceContains:*.step",
    "workspaceContains:*.stl",
    "workspaceContains:*.3mf",
    "workspaceContains:*.dxf",
    "workspaceContains:*.svg"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool source-map --config ./webpack.config.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "format-check": "prettier --check \"src/**/*.ts\"",
    "test": "vscode-test",
    "vsce-package": "vsce package -o partcad.vsix",
    "cspell-dictionary": "node cspell/generate.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "partcad-yaml",
        "aliases": [
          "PartCAD Package Configuration",
          "partcad.yaml"
        ],
        "filenames": [
          "partcad.yaml"
        ],
        "configuration": "./syntaxes/partcad-yaml.language-configuration.json",
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      },
      {
        "id": "partcad-assy",
        "aliases": [
          "PartCAD ASSY",
          "assy"
        ],
        "extensions": [
          ".assy"
        ],
        "configuration": "./syntaxes/partcad-yaml.language-configuration.json",
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      },
      {
        "id": "xml",
        "extensions": [
          ".world"
        ],
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "partcad-assy",
        "scopeName": "source.partcad.yaml",
        "path": "./syntaxes/partcad-yaml.tmLanguage.json",
        "unbalancedBracketScopes": [
          "invalid.illegal",
          "meta.scalar.yaml",
          "storage.type.tag.shorthand.yaml",
          "keyword.control.flow"
        ]
      },
      {
        "language": "partcad-yaml",
        "scopeName": "source.partcad.yaml",
        "path": "./syntaxes/partcad-yaml.tmLanguage.json",
        "unbalancedBracketScopes": [
          "invalid.illegal",
          "meta.scalar.yaml",
          "storage.type.tag.shorthand.yaml",
          "keyword.control.flow"
        ]
      }
    ],
    "configurationDefaults": {
      "[partcad-assy]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "diffEditor.ignoreTrimWhitespace": false
      },
      "[partcad-yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "diffEditor.ignoreTrimWhitespace": false
      }
    },
    "configuration": [
      {
        "title": "Backend",
        "order": 0,
        "properties": {
          "partcad.servicePath": {
            "default": "",
            "description": "Path to a 'partcad-json-rpc' executable. When empty, the extension looks for an existing standalone installation and for a 'partcad-json-rpc' on the PATH, and uses whatever it finds without asking. Only when it finds none does it offer to download the standalone PartCAD or to be pointed at a local Python environment that has PartCAD installed -- and 'Find installed PartCAD' fills this setting in. Note that the PATH searched is the one VS Code itself was started with, which does not include a Python virtual environment unless VS Code was launched from it; set this by hand if your installation is not being found.",
            "scope": "machine",
            "type": "string"
          },
          "partcad.addToolsToTerminalPath": {
            "default": true,
            "description": "Put the PartCAD command line tools (`pc`, `partcad`) on the PATH of terminals opened in this window, so they work without installing anything or editing a shell profile. Applies to terminals opened after the extension activates, and is re-applied after the shell has read its startup files (so a `conda init` there cannot put another `pc` ahead) when the terminal has shell integration, which it does by default; VS Code shows which extension changed the environment. Turn this off to keep a PartCAD of your own on the PATH instead.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.serviceChannel": {
            "default": "socket",
            "description": "How the extension connects to the PartCAD service. 'socket' uses a shared per-workspace background daemon (recommended); 'stdio' runs a dedicated service process over stdin/stdout.",
            "enum": [
              "socket",
              "stdio"
            ],
            "enumDescriptions": [
              "Connect to the shared per-workspace daemon over a socket (or a named pipe on Windows).",
              "Run a dedicated service process and talk to it over stdin/stdout."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.serviceDownloadRepository": {
            "default": "partcad/partcad",
            "description": "GitHub repository (owner/name) to download the standalone PartCAD bundle from.",
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Python",
        "order": 1,
        "properties": {
          "partcad.pythonSandbox": {
            "default": "",
            "description": "What sandboxing method to use for invoking Python scripts. Leave it automatic unless you mean it: a method chosen here is obeyed, so a package's own container image (a CAE solver, say) is not used unless the method is 'docker'.",
            "enum": [
              "",
              "docker",
              "conda",
              "venv",
              "remote",
              "pypy",
              "none"
            ],
            "enumDescriptions": [
              "Let PartCAD choose: Docker where a container runtime answers, else conda where this machine has it, else venv. The same as 'pythonSandbox' in ~/.partcad/config.yaml when that is set.",
              "Build sandboxes in Docker containers, including the image a package names for itself.",
              "Use conda to create a sandboxed environment.",
              "Use a virtual environment built from a Python on this machine.",
              "Use the partcad-service-remote-docker service named by 'remoteSandbox'.",
              "Use pypy to create a sandboxed environment.",
              "Do not create a sandboxed environment. Use the current Python environment instead."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Third-party applications",
        "order": 2,
        "properties": {
          "partcad.open.useDocker": {
            "default": true,
            "description": "Let PartCAD run a third-party application (\"Open in...\": FreeCAD, Blender, Gazebo, MuJoCo, KiCad) in a Docker container when it is not installed on this machine, and Docker is running here. The container is named after the application ('partcad-freecad', 'partcad-blender', 'partcad-gazebo', 'partcad-mujoco', 'partcad-kicad'), keeps the workspace mounted at the path it has here, and shows its windows on this machine's X display - which macOS and Windows need an X server for.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.open.dockerImage": {
            "default": "",
            "description": "Create that container from this image instead of the application's default one (FreeCAD: 'linuxserver/freecad:latest', Blender: 'linuxserver/blender:latest', Gazebo: 'gazebosim/gz-harmonic:latest', MuJoCo: 'ghcr.io/google-deepmind/mujoco:latest', KiCad: the 'ghcr.io/partcad/partcad-container-kicad' image of this release). Applies to whichever application is opened next and only when its container is created; remove an existing one to have it recreated.",
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "General",
        "order": 3,
        "properties": {
          "partcad.verbosity": {
            "default": "info",
            "description": "What level of logs need to be displayed in the PartCAD terminal view?",
            "enum": [
              "debug",
              "info",
              "error"
            ],
            "enumDescriptions": [
              "Show debug information (especially useful for debugging AI).",
              "Show regular informational messages.",
              "Show errors only."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.packagePath": {
            "default": ".",
            "description": "Relative path to the PartCad package root from the workspace root.",
            "scope": "resource",
            "type": "string"
          },
          "partcad.installOnOpen": {
            "default": "false",
            "description": "Whether to download the package's dependencies (as `pc install` does) the first time a workspace directory is opened. The package installed is the one `partcad.packagePath` points at. Off by default: this downloads the whole transitive dependency closure with force-update on -- for a package that imports the public index that is around a hundred packages and several minutes -- and the daemon serialises every request behind it, so the window stays unresponsive for the duration. Run \"PartCAD: Install the package dependencies\" when you want it.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Install the dependencies when a workspace directory is opened for the first time.",
              "Never install automatically; run \"PartCAD: Install the package dependencies\" by hand."
            ],
            "scope": "resource",
            "type": "string"
          },
          "partcad.forceUpdate": {
            "default": "false",
            "description": "Whether to update all dependencies on each run, instead of once a day.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Update all dependencies on each run.",
              "Update dependencies once a day."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.develIndex": {
            "default": false,
            "description": "Whether to take the public PartCAD index from its 'devel' branch instead of the released state on 'main'. Turn this on to work against index changes that have not been released yet.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.showNotifications": {
            "default": "always",
            "description": "Controls when notifications are shown by this extension.",
            "enum": [
              "off",
              "onError",
              "onWarning",
              "always"
            ],
            "enumDescriptions": [
              "All notifications are turned off, any errors or warning are still available in the logs.",
              "Notifications are shown only in the case of an error.",
              "Notifications are shown for errors and warnings.",
              "Notifications are show for anything that the server chooses to show."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.telemetry": {
            "default": "on",
            "description": "Controls whether to send PartCAD processes telemetry data to help with PartCAD development. PartCAD collects error messages and time measurements of internal components to guide performance optimization.",
            "enum": [
              "on",
              "off"
            ],
            "enumDescriptions": [
              "PartCAD Telemetry is enabled.",
              "PartCAD Telemetry is disabled."
            ],
            "scope": "machine",
            "tags": [
              "telemetry",
              "usesOnlineServices"
            ],
            "type": "string"
          },
          "partcad.reopenTerminal": {
            "default": "false",
            "description": "Whether to re-open the PartCAD terminal on new PartCAD output after it was closed. It opens on the first output either way, and \"PartCAD: Show Terminal\" or the PartCAD entry in the terminal panel's \"+\" menu opens it again, with what it missed. It also opens, whatever this says, when PartCAD stops working in the window.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Re-open the PartCAD terminal on new output, if it was closed.",
              "Leave the PartCAD terminal closed once it is closed, until it is opened again."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.popupTerminal": {
            "default": "false",
            "description": "Whether to bring the PartCAD terminal tab up on new PartCAD events or not.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Bring the PartCAD terminal up on new events, if it was hidden.",
              "Do not bring the PartCAD terminal up on new events if it is hidden."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Lint",
        "order": 4,
        "properties": {
          "partcad.lint.enabled": {
            "default": true,
            "description": "Check ASSY files and `partcad.yaml` while editing -- Jinja2, YAML, schema, and the rules for what is marked manufacturable -- and report the findings in the Problems view.",
            "scope": "resource",
            "type": "boolean",
            "order": 0
          },
          "partcad.lint.includePaths": {
            "default": [],
            "order": 1,
            "markdownDescription": "Directories an ASSY file or a `partcad.yaml` may `{% include %}` or `{% import %}` from, besides its own directory and the `includePaths` a package above it declares for it. Use this for what is declared by a package the checker cannot see from where the file is -- one that imports this package from elsewhere. Relative to the workspace folder the file is in.",
            "items": {
              "type": "string"
            },
            "scope": "resource",
            "type": "array"
          },
          "partcad.lint.extraParams": {
            "default": [],
            "order": 2,
            "markdownDescription": "Parameter values to render ASSY files with instead of their declared defaults, written the way `pc --extra-param` takes them: `object.parameter=value`, e.g. `desk.length=60` or `//pub/furniture:desk.length=60`. The object may be named with or without its package, and its name may have dots of its own. The value is read as the type the parameter declares. Applied on top of the `parameters:` in `~/.partcad/config.yaml`, which the checker reads too.",
            "items": {
              "type": "string",
              "pattern": "^.+\\.[^.=]+=.*$",
              "patternErrorMessage": "Write it as object.parameter=value"
            },
            "scope": "resource",
            "type": "array"
          }
        }
      },
      {
        "title": "PartCAD Viewer",
        "order": 5,
        "properties": {
          "partcad.spaceMouse.enabled": {
            "default": true,
            "description": "Navigate the 3D view with a 3Dconnexion SpaceMouse: the cap moves the model the way it is pushed and twisted (3Dconnexion's \"object mode\"), and the \"Fit\" button frames it again. On Windows and macOS the viewer reads the device itself; on Linux it reads it from spacenavd, which has to be running.",
            "type": "boolean"
          },
          "partcad.spaceMouse.sensitivity": {
            "default": 1,
            "minimum": 0.05,
            "maximum": 20,
            "description": "How fast a SpaceMouse moves the model. 1 is the default; 2 is twice as fast.",
            "type": "number"
          },
          "partcad.spaceMouse.invert": {
            "default": [],
            "description": "SpaceMouse axes whose direction is reversed: 'tx' (push left/right: pan), 'ty' (pull up/push down: pan), 'tz' (push away/pull toward you: zoom), 'rx' (tilt forward/back), 'ry' (twist), 'rz' (tilt left/right). The view keeps its up direction, so 'rz' - a roll about the line of sight - has no effect of its own.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "tx",
                "ty",
                "tz",
                "rx",
                "ry",
                "rz"
              ]
            }
          },
          "partcad.viewer.performanceDebug": {
            "default": false,
            "description": "Enable performance debugging: triangle counts in tree, metrics display (top-right), and console logs. Shows part geometry complexity and rendering performance.",
            "type": "boolean"
          }
        }
      }
    ],
    "commands": [
      {
        "title": "Restart PartCAD",
        "category": "PartCAD",
        "command": "partcad.restart",
        "icon": "$(refresh)",
        "enablement": "!partcad.editingExternally"
      },
      {
        "title": "Update PartCAD",
        "category": "PartCAD",
        "command": "partcad.update",
        "icon": "$(cloud-download)",
        "enablement": "!partcad.editingExternally"
      },
      {
        "title": "Show Terminal",
