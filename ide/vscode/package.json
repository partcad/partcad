    "menus": {
      "view/title": [
        {
          "command": "partcad.promptLoadPackage",
          "when": "view == partcadContext",
          "group": "navigation"
        },
        {
          "command": "partcad.update",
          "when": "view == partcadContext",
          "group": "navigation"
        },
        {
          "command": "partcad.restart",
          "when": "view == partcadContext",
          "group": "navigation"
        },
        {
          "submenu": "partcad.submenu.add",
          "when": "partcad.packageLoaded && view == partcadExplorer",
          "group": "navigation"
        },
        {
          "submenu": "partcad.submenu.import",
          "when": "partcad.packageLoaded && view == partcadExplorer",
          "group": "navigation"
        },
        {
          "command": "partcad.inspectFileRoot",
          "when": "partcad.packageLoaded && view == partcadExplorer",
          "group": "navigation"
        },
        {
          "command": "partcad.refresh",
          "when": "partcad.packageLoaded && view == partcadExplorer",
          "group": "additional_commands"
        },
        {
          "command": "partcad.installPackage",
          "when": "partcad.packageLoaded && view == partcadExplorer",
          "group": "additional_commands"
        },
        {
          "command": "partcad.support",
          "when": "view == partcadExplorer",
          "group": "additional_commands"
        }
      ],
      "view/item/context": [
        {
          "command": "partcad.inspectSketch",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == sketch || viewItem == sketchWithCode)"
        },
        {
          "command": "partcad.inspectInterface",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == interface || viewItem == interfaceWithCode)"
        },
        {
          "command": "partcad.inspectPart",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == part || viewItem == partWithAI || viewItem == partWithCode || viewItem == partKicad)"
        },
        {
          "command": "partcad.inspectAssembly",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == assembly || viewItem == assemblyWithCode)"
        },
        {
          "command": "partcad.inspectScene",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == scene || viewItem == sceneWithCode || viewItem == sceneWorld)"
        },
        {
          "command": "partcad.test",
          "group": "navigation"
        },
        {
          "command": "partcad.inspectSource",
          "group": "inline",
          "when": "view == partcadExplorer && (viewItem == partWithAI || viewItem == partWithCode || viewItem == assemblyWithCode || viewItem == sceneWithCode || viewItem == sceneWorld || viewItem == packageWithCode || viewItem == interfaceWithCode)"
        },
        {
          "command": "partcad.inspectSource",
          "group": "navigation",
          "when": "view == partcadExplorer && (viewItem == partWithAI || viewItem == partWithCode || viewItem == assemblyWithCode || viewItem == sceneWithCode || viewItem == sceneWorld || viewItem == packageWithCode)"
        },
        {
          "submenu": "partcad.submenu.addItem",
          "when": "view == partcadExplorer && (viewItem == package || viewItem == packageWithCode)",
          "group": "additional_commands"
        },
        {
          "submenu": "partcad.submenu.import",
          "when": "view == partcadExplorer && (viewItem == package || viewItem == packageWithCode)",
          "group": "additional_commands"
        },
        {
          "submenu": "partcad.submenu.convert",
          "when": "view == partcadExplorer && (viewItem == part || viewItem == partWithAI || viewItem == partWithCode || viewItem == partKicad)",
          "group": "additional_commands"
        },
        {
          "submenu": "partcad.submenu.export",
          "when": "view == partcadExplorer && (viewItem == part || viewItem == partWithAI || viewItem == partWithCode || viewItem == partKicad || viewItem == assembly || viewItem == assemblyWithCode || viewItem == scene || viewItem == sceneWithCode || viewItem == sceneWorld)",
          "group": "additional_commands"
        },
        {
          "submenu": "partcad.submenu.openWith",
          "when": "view == partcadExplorer && (viewItem == part || viewItem == partWithAI || viewItem == partWithCode || viewItem == partKicad || viewItem == assembly || viewItem == assemblyWithCode || viewItem == sceneWorld)",
          "group": "additional_commands"
        }
      ],
      "partcad.submenu.add": [
        {
          "command": "partcad.addInterface",
          "group": "add",
          "when": "partcad.packageLoaded && view == partcadExplorer"
        },
        {
          "command": "partcad.addSketch",
          "group": "add",
          "when": "partcad.packageLoaded && view == partcadExplorer"
        },
        {
          "command": "partcad.addPart",
          "group": "add",
