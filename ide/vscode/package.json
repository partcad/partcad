{
  "name": "partcad",
  "displayName": "PartCAD",
  "description": "Build system and package manager for CAD files, and assembly modeling framework",
  "markdown": "github",
  "icon": "resources/logo_128x128.png",
  "version": "0.8.21",
  "serverInfo": {
    "name": "PartCAD",
    "module": "partcad"
  },
  "publisher": "OpenVMP",
  "license": "Apache-2.0",
  "homepage": "https://partcad.readthedocs.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/openvmp/partcad.git"
  },
  "bugs": {
    "url": "https://github.com/openvmp/partcad/issues"
  },
  "galleryBanner": {
    "color": "#1e415e",
    "theme": "dark"
  },
  "keywords": [
    "partcad",
    "cad",
    "cadquery",
    "build123d",
    "openscad",
    "step",
    "stl",
    "dxf",
    "threejs",
    "autodesk",
    "solidworks",
    "gltf",
    "iges"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PartCAD does not support untrusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Virtual Workspaces are not supported with PartCAD."
    }
  },
  "activationEvents": [
    "workspaceContains:partcad.yaml",
    "onWebviewPanel:partcadViewer",
    "workspaceContains:*.assy",
    "workspaceContains:*cadquery*",
    "workspaceContains:*build123d*",
    "workspaceContains:*.scad",
    "workspaceContains:*.step",
    "workspaceContains:*.stl",
    "workspaceContains:*.3mf",
    "workspaceContains:*.dxf",
    "workspaceContains:*.svg"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool source-map --config ./webpack.config.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "format-check": "prettier --check \"src/**/*.ts\"",
    "test": "vscode-test",
    "vsce-package": "vsce package -o partcad.vsix"
  },
  "contributes": {
    "languages": [
      {
        "filenames": [
          "partcad.yaml"
        ],
        "id": "yaml",
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      },
      {
        "id": "yaml",
        "extensions": [
          ".assy"
        ],
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      },
      {
        "id": "xml",
        "extensions": [
          ".world"
        ],
        "icon": {
          "light": "./resources/logo.svg",
          "dark": "./resources/logo.svg"
        }
      }
    ],
    "configuration": [
      {
        "title": "Backend",
        "order": 0,
        "properties": {
          "partcad.servicePath": {
            "default": "",
            "description": "Path to a 'partcad-json-rpc' executable. When empty, the extension looks for an existing standalone installation and for a 'partcad-json-rpc' on the PATH, and uses whatever it finds without asking. Only when it finds none does it offer to download the standalone PartCAD or to be pointed at a local Python environment that has PartCAD installed -- and 'Find installed PartCAD' fills this setting in. Note that the PATH searched is the one VS Code itself was started with, which does not include a Python virtual environment unless VS Code was launched from it; set this by hand if your installation is not being found.",
            "scope": "machine",
            "type": "string"
          },
          "partcad.addToolsToTerminalPath": {
            "default": true,
            "description": "Put the PartCAD command line tools (`pc`, `partcad`) on the PATH of terminals opened in this window, so they work without installing anything or editing a shell profile. Applies to terminals opened after the extension activates; VS Code shows which extension changed the environment. Turn this off to keep a PartCAD of your own on the PATH instead.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.serviceChannel": {
            "default": "socket",
            "description": "How the extension connects to the PartCAD service. 'socket' uses a shared per-workspace background daemon (recommended); 'stdio' runs a dedicated service process over stdin/stdout.",
            "enum": [
              "socket",
              "stdio"
            ],
            "enumDescriptions": [
              "Connect to the shared per-workspace daemon over a socket (or a named pipe on Windows).",
              "Run a dedicated service process and talk to it over stdin/stdout."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.serviceDownloadRepository": {
            "default": "partcad/partcad",
            "description": "GitHub repository (owner/name) to download the standalone PartCAD bundle from.",
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Python",
        "order": 1,
        "properties": {
          "partcad.pythonSandbox": {
            "default": "conda",
            "description": "What sandboxing method to use for invoking Python scripts?",
            "enum": [
              "conda",
              "pypy",
              "none"
            ],
            "enumDescriptions": [
              "Use conda to create a sandboxed environment.",
              "Use pypy to create a sandboxed environment.",
              "Do not create a sandboxed environment. Use the current Python environment instead."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "Third-party applications",
        "order": 2,
        "properties": {
          "partcad.open.useDocker": {
            "default": false,
            "description": "Let PartCAD run a third-party application (\"Open in...\": FreeCAD, Gazebo, KiCad) in a Docker container when it is not installed on this machine. The container is named after the application ('partcad-freecad', 'partcad-gazebo', 'partcad-kicad'), keeps the workspace mounted at the path it has here, and shows its windows on this machine's X display - which macOS and Windows need an X server for.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.open.dockerImage": {
            "default": "",
            "description": "Create that container from this image instead of the application's default one (FreeCAD: 'linuxserver/freecad:latest', Gazebo: 'gazebosim/gz-harmonic:latest', KiCad: the 'ghcr.io/partcad/partcad-container-kicad' image of this release). Applies to whichever application is opened next and only when its container is created; remove an existing one to have it recreated.",
            "scope": "machine",
            "type": "string"
          }
        }
      },
      {
        "title": "General",
        "order": 3,
        "properties": {
          "partcad.lint.enabled": {
            "default": true,
            "description": "Check ASSY files for Jinja2, YAML and schema errors while editing, and report them in the Problems view.",
            "scope": "resource",
            "type": "boolean"
          },
          "partcad.verbosity": {
            "default": "info",
            "description": "What level of logs need to be displayed in the PartCAD terminal view?",
            "enum": [
              "debug",
              "info",
              "error"
            ],
            "enumDescriptions": [
              "Show debug information (especially useful for debugging AI).",
              "Show regular informational messages.",
              "Show errors only."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.packagePath": {
            "default": ".",
            "description": "Relative path to the PartCad package root from the workspace root.",
            "scope": "resource",
            "type": "string"
          },
          "partcad.installOnOpen": {
            "default": "false",
            "description": "Whether to download the package's dependencies (as `pc install` does) the first time a workspace directory is opened. The package installed is the one `partcad.packagePath` points at. Off by default: this downloads the whole transitive dependency closure with force-update on -- for a package that imports the public index that is around a hundred packages and several minutes -- and the daemon serialises every request behind it, so the window stays unresponsive for the duration. Run \"PartCAD: Install the package dependencies\" when you want it.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Install the dependencies when a workspace directory is opened for the first time.",
              "Never install automatically; run \"PartCAD: Install the package dependencies\" by hand."
            ],
            "scope": "resource",
            "type": "string"
          },
          "partcad.forceUpdate": {
            "default": "false",
            "description": "Whether to update all dependencies on each run, instead of once a day.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Update all dependencies on each run.",
              "Update dependencies once a day."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.develIndex": {
            "default": false,
            "description": "Whether to take the public PartCAD index from its 'devel' branch instead of the released state on 'main'. Turn this on to work against index changes that have not been released yet.",
            "scope": "machine",
            "type": "boolean"
          },
          "partcad.showNotifications": {
            "default": "always",
            "description": "Controls when notifications are shown by this extension.",
            "enum": [
              "off",
              "onError",
              "onWarning",
              "always"
            ],
            "enumDescriptions": [
              "All notifications are turned off, any errors or warning are still available in the logs.",
              "Notifications are shown only in the case of an error.",
              "Notifications are shown for errors and warnings.",
              "Notifications are show for anything that the server chooses to show."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.telemetry": {
            "default": "on",
            "description": "Controls whether to send PartCAD processes telemetry data to help with PartCAD development. PartCAD collects error messages and time measurements of internal components to guide performance optimization.",
            "enum": [
              "on",
              "off"
            ],
            "enumDescriptions": [
              "PartCAD Telemetry is enabled.",
              "PartCAD Telemetry is disabled."
            ],
            "scope": "machine",
            "tags": [
              "telemetry",
              "usesOnlineServices"
            ],
            "type": "string"
          },
          "partcad.reopenTerminal": {
            "default": "true",
            "description": "Whether to re-open PartCAD terminal tab on new PartCAD events or not.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Re-open PartCAD terminal on new events, if it was closed.",
              "Do not re-open PartCAD terminal if closed once."
            ],
            "scope": "machine",
            "type": "string"
          },
          "partcad.popupTerminal": {
            "default": "false",
            "description": "Whether to bring the PartCAD terminal tab up on new PartCAD events or not.",
            "enum": [
              "true",
              "false"
            ],
            "enumDescriptions": [
              "Bring the PartCAD terminal up on new events, if it was hidden.",
              "Do not bring the PartCAD terminal up on new events if it is hidden."
            ],
            "scope": "machine",
            "type": "string"
          }
        }
      }
    ],
