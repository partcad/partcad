    "views": {
      "partcad-container": [
        {
          "id": "partcadContext",
          "type": "webview",
          "name": "Context",
          "icon": "resources/logo.svg",
          "contextualTitle": "PartCAD Context",
          "initialSize": 5,
          "visibility": "collapsed",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "partcadExplorer",
          "name": "Explorer",
          "icon": "resources/logo.svg",
          "contextualTitle": "PartCAD Explorer"
        },
        {
          "id": "partcadInspector",
          "type": "webview",
          "name": "Inspector",
          "icon": "resources/logo.svg",
          "contextualTitle": "PartCAD Inspector",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "partcadExplorer",
        "contents": "PartCAD is turned off in this folder until you trust it.\n\nOpening a PartCAD package runs the code its parts are written in, and fetches the packages it imports. The editor has opened this folder in Restricted Mode, so PartCAD waits until you say the folder is one you trust.\n\n[Manage Workspace Trust](command:workbench.trust.manage)\n\nLearn more about [Workspace Trust](https://code.visualstudio.com/docs/editing/workspaces/workspace-trust).",
        "when": "!isWorkspaceTrusted"
      },
      {
        "view": "partcadExplorer",
        "contents": "Hang in there!\nThe PartCAD extension is being initialized...",
        "when": "isWorkspaceTrusted && !partcad.activated && !partcad.failed && !partcad.serviceMissing"
      },
      {
        "view": "partcadExplorer",
        "contents": "No PartCAD was found.\n\nThe extension needs a PartCAD to talk to. Install one below and it will be downloaded for you, or point the extension at a Python environment that already has one (`pip install partcad`).\n\nPartCAD is the first package manager for CAD files. Learn more about PartCAD in our [GitHub repository](https://github.com/partcad/partcad) or [documentation](https://partcad.readthedocs.io/).\n\n[Install or find PartCAD](command:partcad.startInstall)",
        "when": "partcad.serviceMissing"
      },
      {
        "view": "partcadExplorer",
        "contents": "PartCAD initialization failed!",
        "when": "!partcad.activated && partcad.failed && partcad.workspaceIsGood"
      },
      {
        "view": "partcadExplorer",
        "contents": "No workspace initialized.",
        "when": "!partcad.activated && partcad.failed && !partcad.workspaceIsGood"
      },
      {
        "view": "partcadExplorer",
        "contents": "Hang in there!\nPartCAD is starting...\n\nHealth checks run before the package is loaded, so the first start after an installation is the slow one. The PartCAD terminal view shows what it is doing.",
        "when": "partcad.activated && !partcad.installed && !partcad.beingInstalled && !partcad.failed"
      },
      {
        "view": "partcadExplorer",
        "contents": "PartCAD did not finish starting.\n\nThe extension reached a PartCAD service, so one is installed -- activating it is what failed. The reason is in the PartCAD terminal view.\n\n[Restart PartCAD](command:partcad.restart)\n[Install or update PartCAD](command:partcad.startInstall)",
        "when": "partcad.activated && !partcad.installed && !partcad.beingInstalled && partcad.failed"
      },
      {
        "view": "partcadExplorer",
        "contents": "PartCAD needs to be updated for the current package to work properly.\n\n[Update PartCAD](command:partcad.startInstall)",
        "when": "partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "Hang in there!\nPartCAD is being installed...",
        "when": "partcad.activated && !partcad.installed && partcad.beingInstalled"
      },
      {
        "view": "partcadExplorer",
        "contents": "Loading the package...\n\nPlease, wait... \n\nSee the terminal view for more information on what exactly is taking time.",
        "when": "partcad.activated && partcad.installed && partcad.packageContentsBeingLoaded"
      },
      {
        "view": "partcadExplorer",
        "contents": "No PartCAD package is detected.\n\nThe default package configuration file is `partcad.yaml` in the top workspace folder.",
        "when": "partcad.activated && partcad.installed && !partcad.beingLoaded && !partcad.packageLoaded && !partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "[Create package](command:partcad.promptInitPackage)",
        "when": "partcad.activated && partcad.installed && !partcad.beingLoaded && !partcad.packageLoaded && !partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "If you are an advanced PartCAD user and you prefer to use another configuration file then create a custom package.",
        "when": "partcad.activated && partcad.installed && !partcad.beingLoaded && !partcad.packageLoaded && !partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "[Create custom package](command:partcad.promptInitPackageCustom)",
        "when": "partcad.activated && partcad.installed && !partcad.beingLoaded && !partcad.packageLoaded && !partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "If there is already an existing PartCAD package in another folder of this workspace, then open the package folder or the package configuration file.\n[Open existing package](command:partcad.promptLoadPackage)",
        "when": "partcad.activated && partcad.installed && !partcad.beingLoaded && !partcad.packageLoaded && !partcad.needsUpdate"
      },
      {
        "view": "partcadExplorer",
        "contents": "This package is empty.\n[Add a part](command:partcad.addPart)\n[Add an assembly](command:partcad.addAssembly)",
        "when": "partcad.activated && partcad.installed && partcad.packageLoaded && !partcad.packageContentsBeingLoaded && !partcad.itemsReceived"
      },
      {
        "view": "partcadInspector",
        "contents": "",
        "when": "!partcad.packageLoaded"
      },
      {
        "view": "partcadInspector",
        "contents": "Select a package or a model in the Explorer view above.",
        "when": "partcad.packageLoaded && !partcad.itemSelected"
      }
    ]
  },
